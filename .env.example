# Copy this file to .env and fill in real values before running.
# .env is git-ignored and must never be committed.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=teach_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=teach_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_64_char_hex_secret

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email of the account allowed to read /api/admin/feedback. If unset, the
# admin endpoint denies everyone.
ADMIN_EMAIL=

# ── CORS / Domain ─────────────────────────────────────────────────────────────
# Set to your public domain once registered, e.g. https://barashada.com
# Leave blank for local-only access
FRONTEND_URL=

# ── Grafana ────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# ── Audio cleanup ─────────────────────────────────────────────────────────────
# Days to keep teacher conversation audio. Lesson audio (tts_*.mp3) is kept forever.
AUDIO_TEACHER_MAX_AGE_DAYS=7

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
# Paste token from: cloudflared tunnel create teach
CLOUDFLARE_TUNNEL_TOKEN=

# ── Chat LLM: AI tutor / conversation brain ───────────────────────────────────
# The chat brain runs on a hosted, FREE OpenAI-compatible model via OpenRouter,
# so no local GPU model is needed. Get a key at https://openrouter.ai/keys.
# Free models are a shared pool and get rate-limited, so LLM_FALLBACK_MODELS lists
# alternates that ask_qwen() rolls over to. To run locally instead, set
# QWEN_URL=http://qwen-brain:8000/v1/chat/completions, leave OPENROUTER_API_KEY
# blank, and uncomment the qwen service in docker-compose.yml.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
QWEN_URL=https://openrouter.ai/api/v1/chat/completions
QWEN_MODEL=inclusionai/ling-3.0-flash-sante:free
LLM_FALLBACK_MODELS=minimax/minimax-m3:free,liquid/lfm-2.5-2.6b:free

# Folded tutor translation (see docs/translation-model-decision.md). The tutor
# understands Somali + replies in Somali in ONE call — no NLLB on the runtime path.
# Primary is a cheap paid model (quality + no free-tier 429s); it falls back to a
# free model, then to the ask_qwen chain. LLM_DAILY_SPEND_CAP_USD bounds spend/day
# (0 = free-only). *_PER_M are the primary's price per 1M tokens (for the cap only).
FOLDED_MODEL=deepseek/deepseek-v4-flash-0731
FOLDED_FALLBACK_MODEL=nex-agi/nex-n2.5-pro:free
FOLDED_INPUT_PER_M=0.065
FOLDED_OUTPUT_PER_M=0.18
LLM_DAILY_SPEND_CAP_USD=5.0

# Per-user daily tutor limit (chat + explain turns), by plan (users.plan).
# Enforced via strict per-user accounting (user_llm_usage). Over the limit → 429.
TUTOR_FREE_DAILY_LIMIT=25
TUTOR_PAID_DAILY_LIMIT=500

# ── Text-to-speech ────────────────────────────────────────────────────────────
# Primary is OpenRouter's FREE flux-tts (no GPU, no local model), called via the
# OpenAI-compatible /audio/speech endpoint with OPENROUTER_API_KEY. edge-tts is the
# keyless fallback (429 resilience + regional accents flux lacks). Kokoro retired.
TTS_URL=https://openrouter.ai/api/v1/audio/speech
TTS_MODEL=deepgram/flux-tts:free
TTS_FLUX_VOICE=flux-alexis-en

# ── Optional external services ────────────────────────────────────────────────
# HUGGING_FACE_HUB_TOKEN is only needed if you run the local qwen container.
HUGGING_FACE_HUB_TOKEN=
